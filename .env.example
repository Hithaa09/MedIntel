# Oracle XE connection – copy to .env and fill in your values
DB_USER=APP
DB_PASS=app
DB_DSN=localhost:1521/XEPDB1

# Connection pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=10

# CORS – origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
