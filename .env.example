# PostgreSQL connection string (Render provides this automatically via render.yaml)
DATABASE_URL=postgresql://user:password@host:5432/medintel

# Connection pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT secret — generate a strong random string for production
SECRET_KEY=change-me-to-a-long-random-secret

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://medintel-frontend.onrender.com,http://localhost:5500,http://127.0.0.1:5500
